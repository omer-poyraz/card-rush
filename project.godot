; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-8602764456287198~3978960722"

[application]

config/name="Card Rush"
config/description="Card Rush — renk ve sayı eşleştirme kart oyunu"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.043, 0.11, 1)
boot_splash/show_image=false
config/icon="res://assets/branding/icon_192.png"

[audio]

driver/enable_input=true

[autoload]

Save="*res://scripts/persistence/save_manager.gd"
Settings="*res://scripts/core/settings_manager.gd"
Loc="*res://scripts/localization/localization_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"
App="*res://scripts/core/app.gd"
Net="*res://scripts/networking/network_manager.gd"
Voice="*res://scripts/voice/voice_chat_manager.gd"
Store="*res://scripts/purchases/purchase_manager.gd"
Ads="*res://scripts/ads/ad_manager.gd"

[card_rush]

online/signaling_url=""
store/android_package="com.poyrazyazilim.cardrush"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://data/localization/strings.tr.translation", "res://data/localization/strings.en.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.043, 0.11, 1)
