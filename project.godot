; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Card Rush"
config/description="Card Rush — renk ve sayı eşleştirme kart oyunu"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.043, 0.11, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/persistence/save_manager.gd"
Settings="*res://scripts/core/settings_manager.gd"
Loc="*res://scripts/localization/localization_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"
App="*res://scripts/core/app.gd"
Net="*res://scripts/networking/network_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/translations=PackedStringArray("res://data/localization/strings.tr.translation", "res://data/localization/strings.en.translation")
locale/fallback="en"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.039, 0.043, 0.11, 1)
